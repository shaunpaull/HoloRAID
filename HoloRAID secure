import argparse
import json
import os
from pathlib import Path
import random
import tempfile

from cryptography.hazmat.primitives.serialization import NoEncryption, PrivateFormat


MANIFEST_FILENAME = "manifest.hrm2"
SHARD_GLOB = "shard_*.hrs2"
TRUST_ANCHOR_FILENAME = "TRUST_ANCHOR.txt"
METADATA_FILENAME = "bundle_info.json"


def _atomic_write(path: Path, data: bytes, *, mode: int = 0o644) -> None:
    """Write bytes using a same-directory temporary file and atomic replace."""
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{secrets.token_hex(8)}.tmp")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    except Exception:
        try:
            temporary.unlink(missing_ok=True)
        finally:
            raise


def _load_or_create_signing_key(path: Path) -> tuple[Ed25519PrivateKey, bool]:
    """Load a raw 32-byte Ed25519 private key or create it with mode 0600."""
    if path.exists():
        raw = path.read_bytes()
        if len(raw) != 32:
            raise IntegrityError(
                f"signing key {path} must contain exactly 32 raw bytes; found {len(raw)}"
            )
        return Ed25519PrivateKey.from_private_bytes(raw), False

    path.parent.mkdir(parents=True, exist_ok=True)
    private_key = Ed25519PrivateKey.generate()
    raw = private_key.private_bytes(Encoding.Raw, PrivateFormat.Raw, NoEncryption())
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "wb") as handle:
        handle.write(raw)
        handle.flush()
        os.fsync(handle.fileno())
    return private_key, True


def _resolve_trust_anchor(value: str) -> str:
    """Accept a 64-character SHA-256 fingerprint or a text file containing it."""
    possible_path = Path(value)
    if possible_path.is_file():
        value = possible_path.read_text(encoding="utf-8").strip()
    value = value.strip().lower()
    if len(value) != 64 or any(character not in "0123456789abcdef" for character in value):
        raise IntegrityError("trust anchor must be a 64-character hexadecimal SHA-256 value")
    return value


def _command_encode(args: argparse.Namespace) -> int:
    input_path = Path(args.input)
    output_dir = Path(args.output_dir)
    signing_key_path = Path(args.signing_key)

    plaintext = input_path.read_bytes()
    signing_key, created = _load_or_create_signing_key(signing_key_path)
    codec = HoloRAIDSecure(
        n=args.n,
        k=args.k,
        prime_start=args.prime_start,
        signing_key=signing_key,
    )
    bundle = codec.encode(plaintext)

    output_dir.mkdir(parents=True, exist_ok=True)
    planned = [output_dir / MANIFEST_FILENAME]
    planned.extend(output_dir / f"shard_{index:03d}.hrs2" for index in range(codec.n))
    planned.extend(
        [output_dir / TRUST_ANCHOR_FILENAME, output_dir / METADATA_FILENAME]
    )
    occupied = [str(path) for path in planned if path.exists()]
    if occupied and not args.force:
        raise FileExistsError(
            "refusing to overwrite existing output; use --force: " + ", ".join(occupied)
        )

    _atomic_write(output_dir / MANIFEST_FILENAME, bundle.manifest.to_bytes())
    for shard in bundle.shards:
        _atomic_write(output_dir / f"shard_{shard.index:03d}.hrs2", shard.to_bytes())

    trust_anchor = bundle.trust_anchor
    _atomic_write(
        output_dir / TRUST_ANCHOR_FILENAME,
        (trust_anchor + "\n").encode("ascii"),
    )
    metadata = {
        "format": "HoloRAID Secure v2",
        "input_name": input_path.name,
        "plaintext_bytes": len(plaintext),
        "n": codec.n,
        "k": codec.k,
        "recoverable_erasures": codec.n - codec.k,
        "chunk_size_bytes": codec.chunk_size,
        "serialized_bytes": bundle.serialized_size,
        "serialized_storage_factor": (
            bundle.serialized_size / len(plaintext) if plaintext else None
        ),
        "trust_anchor_sha256": trust_anchor,
        "security": {
            "plaintext_confidentiality": "ChaCha20-Poly1305 with a fresh 256-bit key and nonce",
            "threshold_key_release": f"Shamir {codec.k}-of-{codec.n}",
            "shard_authentication": "Ed25519 signatures",
            "rewrite_detection": "signature, manifest metadata, ciphertext SHA-256, and AEAD tag",
        },
    }
    _atomic_write(
        output_dir / METADATA_FILENAME,
        (json.dumps(metadata, indent=2, sort_keys=True) + "\n").encode("utf-8"),
    )

    print("HoloRAID Secure encode complete")
    print(f"Input                      : {input_path}")
    print(f"Plaintext bytes            : {len(plaintext):,}")
    print(f"Configuration              : n={codec.n}, k={codec.k}")
    print(f"Recoverable erasures       : {codec.n - codec.k}")
    print(f"Output directory           : {output_dir}")
    print(f"Signing key                : {signing_key_path} ({'created' if created else 'loaded'})")
    print(f"Trust anchor SHA-256       : {trust_anchor}")
    print("SECURITY ACTION            : copy the trust anchor to a separate trusted channel.")
    print("Do not rely only on the copy stored beside the shards.")
    return 0


def _command_decode(args: argparse.Namespace) -> int:
    input_dir = Path(args.input_dir)
    output_path = Path(args.output)
    trust_anchor = _resolve_trust_anchor(args.trust_anchor)

    manifest = Manifest.from_bytes((input_dir / MANIFEST_FILENAME).read_bytes())
    parsed_shards: list[Optional[Shard]] = []
    parse_failures: list[tuple[str, str]] = []
    for path in sorted(input_dir.glob(SHARD_GLOB)):
        try:
            parsed_shards.append(Shard.from_bytes(path.read_bytes()))
        except (IntegrityError, OSError, ValueError) as exc:
            parse_failures.append((path.name, str(exc)))

    codec = HoloRAIDSecure(
        n=manifest.n,
        k=manifest.k,
        max_subset_trials=args.max_subset_trials,
    )
    plaintext, report = codec.decode(
        manifest,
        parsed_shards,
        expected_trust_anchor=trust_anchor,
    )
    _atomic_write(output_path, plaintext)

    print("HoloRAID Secure decode complete")
    print(f"Output                     : {output_path}")
    print(f"Recovered plaintext bytes  : {len(plaintext):,}")
    print(f"Authentic shard indices    : {report.valid_indices}")
    print(f"Used shard indices         : {report.used_indices}")
    print(f"Rejected/missing records   : {len(report.rejected) + len(parse_failures)}")
    print(f"Candidate subsets tried    : {report.subset_trials}")
    print(f"Recovery time              : {report.elapsed_seconds:.4f}s")
    for name, reason in parse_failures:
        print(f"  malformed {name}: {reason}")
    for index, reason in report.rejected:
        print(f"  rejected shard {index}: {reason}")
    return 0


def _mib_per_second(byte_count: int, seconds: float) -> float:
    if seconds <= 0:
        return float("inf")
    return byte_count / (1024 * 1024) / seconds


def _command_self_test(args: argparse.Namespace) -> int:
    print("=" * 78)
    print("HoloRAID Secure v2 — single-file verification suite")
    print("=" * 78)

    codec = HoloRAIDSecure(n=10, k=6)
    data = os.urandom(args.bytes)

    encode_start = perf_counter()
    bundle = codec.encode(data)
    encode_seconds = perf_counter() - encode_start

    selected_indices = (0, 2, 4, 5, 7, 9)
    recovered, report = codec.decode(
        bundle.manifest,
        [bundle.shards[index] for index in selected_indices],
        expected_trust_anchor=bundle.trust_anchor,
    )
    assert recovered == data

    # Exhaust every threshold subset on a smaller independent payload.
    subset_data = os.urandom(2048)
    subset_bundle = codec.encode(subset_data)
    subset_total = math.comb(codec.n, codec.k)
    subset_passed = 0
    for indices in combinations(range(codec.n), codec.k):
        value, _ = codec.decode(
            subset_bundle.manifest,
            [subset_bundle.shards[index] for index in indices],
            expected_trust_anchor=subset_bundle.trust_anchor,
        )
        subset_passed += int(value == subset_data)
    assert subset_passed == subset_total

    # Three attacker-rewritten shard payloads plus one erased shard.
    damaged: list[Optional[Shard]] = list(bundle.shards)
    damaged[0] = flip_residue_bit(bundle.shards[0], 0, 1)
    damaged[3] = flip_residue_bit(bundle.shards[3], 1, 2)
    damaged[8] = flip_residue_bit(bundle.shards[8], 2, 3)
    damaged[9] = None
    repaired, tamper_report = codec.decode(
        bundle.manifest,
        damaged,
        expected_trust_anchor=bundle.trust_anchor,
    )
    assert repaired == data
    assert {0, 3, 8}.issubset({index for index, _ in tamper_report.rejected})

    # Below-threshold access must fail closed.
    below_threshold_blocked = False
    try:
        codec.decode(
            bundle.manifest,
            bundle.shards[: codec.k - 1],
            expected_trust_anchor=bundle.trust_anchor,
        )
    except ThresholdError:
        below_threshold_blocked = True
    assert below_threshold_blocked

    # Re-encoding identical plaintext must produce independent ciphertext.
    second = codec.encode(data)
    randomized = (
        bundle.manifest.dataset_id != second.manifest.dataset_id
        and bundle.manifest.nonce != second.manifest.nonce
        and bundle.manifest.ciphertext_sha256 != second.manifest.ciphertext_sha256
        and bundle.shards[0].residues != second.shards[0].residues
    )
    assert randomized

    # The plaintext should never be embedded verbatim in serialized shard records.
    plaintext_absent = all(data not in shard.to_bytes() for shard in bundle.shards)
    assert plaintext_absent

    # An attacker may create a complete replacement bundle, but the original
    # out-of-band trust fingerprint rejects the attacker's signing identity.
    attacker = HoloRAIDSecure(n=10, k=6)
    forged_bundle = attacker.encode(b"attacker-controlled replacement")
    signer_substitution_blocked = False
    try:
        codec.decode(
            forged_bundle.manifest,
            forged_bundle.shards[:6],
            expected_trust_anchor=bundle.trust_anchor,
        )
    except IntegrityError:
        signer_substitution_blocked = True
    assert signer_substitution_blocked

    # Binary disk round-trip with actual CLI serialization objects.
    with tempfile.TemporaryDirectory() as temporary_directory:
        root = Path(temporary_directory)
        _atomic_write(root / MANIFEST_FILENAME, bundle.manifest.to_bytes())
        for shard in bundle.shards:
            _atomic_write(root / f"shard_{shard.index:03d}.hrs2", shard.to_bytes())
        disk_manifest = Manifest.from_bytes((root / MANIFEST_FILENAME).read_bytes())
        disk_shards = [
            Shard.from_bytes(path.read_bytes())
            for path in sorted(root.glob(SHARD_GLOB))
        ]
        disk_plaintext, _ = codec.decode(
            disk_manifest,
            disk_shards[: codec.k],
            expected_trust_anchor=bundle.trust_anchor,
        )
        assert disk_plaintext == data

    # Random bounded attack campaign: no more than n-k unavailable shards.
    random_source = random.Random(20260715)
    survived = 0
    injected_rewrites = 0
    trials = args.trials
    for _ in range(trials):
        trial: list[Optional[Shard]] = list(bundle.shards)
        unavailable = random_source.randint(0, codec.n - codec.k)
        for index in random_source.sample(range(codec.n), unavailable):
            if random_source.random() < 0.5:
                trial[index] = None
            else:
                trial[index] = flip_residue_bit(
                    bundle.shards[index],
                    random_source.randrange(bundle.manifest.num_chunks),
                    random_source.randrange(24),
                )
                injected_rewrites += 1
        value, _ = codec.decode(
            bundle.manifest,
            trial,
            expected_trust_anchor=bundle.trust_anchor,
        )
        survived += int(value == data)
    assert survived == trials

    print(f"Configuration                 : n={codec.n}, k={codec.k}")
    print(f"Test payload                  : {len(data):,} bytes")
    print(f"Recoverable erasures          : {codec.n - codec.k}/{codec.n}")
    print(f"CRT chunk capacity            : {codec.chunk_size} bytes")
    print(f"Payload-only storage factor   : {codec.ideal_residue_overhead:.3f}x")
    print(f"Measured serialized factor    : {bundle.serialized_size / max(1, len(data)):.3f}x")
    print(f"Encode throughput             : {_mib_per_second(len(data), encode_seconds):.2f} MiB/s")
    print(f"Decode throughput             : {_mib_per_second(len(data), report.elapsed_seconds):.2f} MiB/s")
    print(f"Exact authenticated recovery  : {recovered == data}")
    print(f"All k-subsets                 : {subset_passed}/{subset_total} exact")
    print(f"3 rewritten + 1 erased        : recovered={repaired == data}")
    print(f"Rewritten shard signatures    : rejected={len(tamper_report.rejected) - 1}")
    print(f"Below-threshold access        : blocked={below_threshold_blocked}")
    print(f"Same plaintext randomized     : {randomized}")
    print(f"Plaintext absent from shards  : {plaintext_absent}")
    print(f"Signer substitution attack    : blocked={signer_substitution_blocked}")
    print(f"Random attack campaign        : {survived}/{trials} exact recoveries")
    print(f"Injected shard rewrites       : {injected_rewrites} (signature-rejected)")
    print("=" * 78)
    print("RESULT: confidentiality, shard authentication, and threshold recovery passed.")
    print("NOTE: this is a research reference implementation and has not been audited.")
    return 0


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="holoraid_secure_github.py",
        description=(
            "Single-file authenticated and confidential CRT threshold erasure coding. "
            "Requires the 'cryptography' package."
        ),
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    encode_parser = subparsers.add_parser("encode", help="encrypt and split a file")
    encode_parser.add_argument("input", help="plaintext input file")
    encode_parser.add_argument("output_dir", help="directory for manifest and shards")
    encode_parser.add_argument(
        "--signing-key",
        required=True,
        help="raw Ed25519 private-key file; created with mode 0600 when absent",
    )
    encode_parser.add_argument("--n", type=int, default=10, help="total shards (default: 10)")
    encode_parser.add_argument("--k", type=int, default=6, help="required shards (default: 6)")
    encode_parser.add_argument(
        "--prime-start",
        type=int,
        default=2**61 - 1,
        help="first 64-bit prime search candidate",
    )
    encode_parser.add_argument("--force", action="store_true", help="overwrite output files")
    encode_parser.set_defaults(handler=_command_encode)

    decode_parser = subparsers.add_parser("decode", help="authenticate and recover a file")
    decode_parser.add_argument("input_dir", help="directory containing manifest and shards")
    decode_parser.add_argument("output", help="recovered plaintext output file")
    decode_parser.add_argument(
        "--trust-anchor",
        required=True,
        help="trusted SHA-256 fingerprint or path to a file containing it",
    )
    decode_parser.add_argument(
        "--max-subset-trials",
        type=int,
        default=10_000,
        help="maximum authenticated k-subsets to try",
    )
    decode_parser.set_defaults(handler=_command_decode)

    test_parser = subparsers.add_parser("self-test", help="run recovery and attack tests")
    test_parser.add_argument(
        "--bytes",
        type=int,
        default=1024 * 1024,
        help="benchmark payload size (default: 1 MiB)",
    )
    test_parser.add_argument(
        "--trials",
        type=int,
        default=100,
        help="random bounded attack trials (default: 100)",
    )
    test_parser.set_defaults(handler=_command_self_test)
    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = _build_parser()
    args = parser.parse_args(argv)
    try:
        return int(args.handler(args))
    except (HoloRAIDError, OSError, ValueError) as exc:
        parser.exit(2, f"error: {exc}\n")


if __name__ == "__main__":
    raise SystemExit(main())
